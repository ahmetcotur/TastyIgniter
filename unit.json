{
  "listeners": {
    "*:8000": { "pass": "routes/laravel" }
  },
  "routes": [
    {
      "match": { "uri": [ "/index.php*", "~\\.(php)$" ] },
      "action": { "pass": "applications/php" }
    },
    {
      "action": {
        "share": "/var/www/html/public",
        "fallback": { "pass": "applications/php" }
      }
    }
  ],
  "applications": {
    "php": {
      "type": "php",
      "user": "www-data",
      "group": "www-data",
      "root": "/var/www/html",
      "script": "public/index.php",
      "working_directory": "/var/www/html",
      "processes": { "max": 8, "spare": 2 }
    }
  }
}